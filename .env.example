# HDM Industrial — environment contract
# Nunca commitar .env.local. Secrets server-only quando houver backend.

# --- Contact data (público; NUNCA inventar — obter do formulário HDM 7/9/2026 / cliente) ---
NEXT_PUBLIC_HDM_PHONE=
NEXT_PUBLIC_HDM_WHATSAPP=
NEXT_PUBLIC_HDM_EMAIL=

# --- Request backend (Supabase). Sem estes valores:
#     - desenvolvimento: DevRequestRepository (persistência local, modo demo sinalizado)
#     - produção: envio online DESATIVADO com caminho humano (§85)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Preview/staging: permite modo demo em build de produção (preview deploys apenas) ---
NEXT_PUBLIC_DEMO_MODE=false

# --- Site URL (canonical, hreflang, sitemap, OG) ---
NEXT_PUBLIC_SITE_URL=https://www.hdmindustrial.es
